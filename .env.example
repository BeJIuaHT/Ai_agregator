# Copy to .env (git-ignored) and fill in. Never commit real values.
RUNPOD_API_KEY=
# Public key text injected into pods (PUBLIC_KEY env). Path to private key stays local.
SSH_PUBLIC_KEY_FILE=workspace/keys/runpod_ed25519.pub
SSH_PRIVATE_KEY_FILE=workspace/keys/runpod_ed25519
# SAFETY GUARD: pod/volume creation is blocked unless this is exactly "yes"
RUNPOD_ALLOW_SPEND=no
# Filled after deployment
RUNPOD_POD_ID=
RUNPOD_VOLUME_ID=
